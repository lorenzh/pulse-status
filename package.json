{
  "name": "@lorenzh/pulse-status",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Status page and dashboard that reads pulse-api.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit && bun node_modules/typescript7/bin/tsc --noEmit -p e2e",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check:a11y": "bun e2e/run.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#51e95b0eb463b27a196a33b428607bd92443e4f0",
    "@types/bun": "1.4.0",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#4e63c4f23da6fdd29e13bd2bc89df431ff701ad7",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#fa79ba8cd93949fc0cf87f7b41bdaf261dbe4dc6",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
