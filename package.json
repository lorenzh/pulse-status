{
  "name": "@lorenzh/pulse-status",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Status page and dashboard that reads pulse-api.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit && bun node_modules/typescript7/bin/tsc --noEmit -p e2e",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint . && pulse-workflows",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check:a11y": "bun e2e/run.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#04108fa0c67d9a79c0f6d1ade4dd78df3ad8a4a7",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#ebcbbb613328494185833f7133f1242910986948",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#236df214f9df8658f2992dd6f7c100952c07102b",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
