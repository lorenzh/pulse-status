{
  "name": "@lorenzh/pulse-status",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Status page and dashboard that reads pulse-api.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='test/**' --test-coverage-exclude='**/test/**' --test-coverage-exclude='dist/**'",
    "lint": "biome check . && node node_modules/@lorenzh/pulse-config/node_modules/eslint/bin/eslint.js .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#a3432e0451bb24397e77e48a5ee2e9d46913bd05",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#a1c166e46375796b4f70f8499cfb38a55338eb77"
  }
}
