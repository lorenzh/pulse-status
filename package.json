{
  "name": "@lorenzh/pulse-status",
  "version": "0.0.0",
  "description": "Status page and dashboard that reads pulse-api.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#23f8830112abb15a2be77a6f7979a0c986297379"
  }
}
